{
  "name": "TurtleBot3 Simulations",
  "dockerComposeFile": "docker-compose.yml",
  "service": "turtlebot3-sim",
  "workspaceFolder": "/root/turtlebot3_ws",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "redhat.vscode-yaml",
        "redhat.vscode-xml",
        "qwenlm.qwen-code-vscode-ide-companion",
        "tencent-cloud.coding-copilot",
        "Alibaba-Cloud.tongyi-lingma"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "qwen-code.provider": "coding-plan",
        "qwen-code.codingPlanRegion": "china",
        "qwen-code.dotIndicator": true,
        "qwen-code.notifications": true,
        "codingcopilot.autoRun": false,
        "codingcopilot.enableInlineChat": true,
        "codingcopilot.enableAutoCompletions": true,
        "codingcopilot.commitMessageLanguage": "zh_CN"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "shutdownAction": "stopContainer"
}
